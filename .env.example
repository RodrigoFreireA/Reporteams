# Ambiente da aplicação: development, testing, desktop ou production
APP_ENV=development
HOST=127.0.0.1
PORT=5001

# Em produção, obrigatório: gere com `python -c "import secrets; print(secrets.token_urlsafe(48))"`
APP_SECRET_KEY=
DATABASE_URL=sqlite:///instance/reportchart.db
SESSION_COOKIE_SECURE=false

# Opcional: bootstrap automático apenas para o modo desktop. Nunca versionar valores reais.
REPORTCHART_BOOTSTRAP_ADMIN_EMAIL=
REPORTCHART_BOOTSTRAP_ADMIN_PASSWORD=
REPORTCHART_BOOTSTRAP_ADMIN_NAME=Administrador

# Limites de autenticação
PASSWORD_MIN_LENGTH=12
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
LOGIN_RATE_LIMIT_LOCKOUT_SECONDS=900

# Em producao/staging, use Redis para compartilhar o rate limit entre workers.
RATE_LIMIT_REDIS_URL=
PLANNER_RETENTION_DAYS=365

# Resumo opcional por modelo local
AI_SUMMARY_PROVIDER=heuristic
AI_SUMMARY_MODEL=gemma3:1b
AI_SUMMARY_OLLAMA_URL=http://127.0.0.1:11434
AI_SUMMARY_TIMEOUT=60
