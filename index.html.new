<!DOCTYPE html>
<html lang="pt-BR" data-theme="dark" data-palette="teal">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>ReportChart Web</title>
  <script src="https://cdn.plot.ly/plotly-2.32.0.min.js"></script>
  <link rel="stylesheet" href="/static/css/app.css">
</head>

<body>

<!-- Loading overlay -->
<div class="loading-overlay" id="loadingOverlay">
  <div class="spinner"></div>
  <div class="loading-text">Processando dados…</div>
</div>

<!-- Sidebar overlay (fecha ao clicar fora) -->
<div class="sidebar-overlay" id="sidebarOverlay" onclick="closeSidebar()"></div>

<!-- Topbar -->
<div class="topbar">
  <button class="menu-toggle" id="menuToggle" onclick="toggleSidebar()" aria-label="Menu">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
      <line x1="3" y1="6"  x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/>
    </svg>
  </button>
  <div class="logo-mark">
    <svg viewBox="0 0 24 24"><path d="M3 3h18v4H3V3zm0 6h12v4H3V9zm0 6h8v4H3v-4zm14 1l3 3-3 3v-2h-4v-2h4v-2z"/></svg>
  </div>
  <span class="app-name">ReportChart</span>
  <span class="sprint-badge" id="sprintBadge"></span>
  <div class="topbar-user hidden" id="topbarUserWrap">
    <span class="topbar-user-name" id="topbarUserName"></span>
    <button class="btn-topbar" id="btnLogout" onclick="logout()">Sair</button>
  </div>

  <div class="topbar-actions">
    <button class="btn-upload-new" id="btnAdminCharts" onclick="openCustomChartsAdmin()">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
        <path d="M3 3v18h18"/>
        <path d="M7 15l3-3 3 2 4-5"/>
      </svg>
      Graficos
    </button>
    <button class="btn-upload-new" id="btnAdminUsers" onclick="openAdminUsers()">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
        <path d="M16 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/>
        <circle cx="8.5" cy="7" r="4"/>
        <path d="M20 8v6M23 11h-6"/>
      </svg>
      Usuarios
    </button>
    <button class="btn-upload-new" id="btnUploadNew" onclick="resetToUpload()">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M17 8l-5-5-5 5M12 3v12"/>
      </svg>
      Biblioteca
    </button>

    <!-- Palette picker -->
    <div class="palette-btn-wrap" id="paletteBtnWrap">
      <button class="palette-btn" id="paletteBtn" title="Paleta de cores" onclick="togglePalettePanel()">
        <div class="palette-dot"></div>
        <div class="palette-dot2"></div>
      </button>
      <div class="palette-panel" id="palettePanel">
        <div class="palette-panel-title">Paleta de cores</div>
        <div class="palette-grid" id="paletteGrid"></div>
        <div class="palette-sep"></div>
        <div class="palette-panel-title2">Tema</div>
        <div class="theme-row">
          <button class="theme-btn" id="btnThemeDark"  onclick="setTheme('dark')">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/></svg>
            Dark
          </button>
          <button class="theme-btn" id="btnThemeLight" onclick="setTheme('light')">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/>
              <line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
              <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/>
              <line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
              <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
            </svg>
            Light
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Layout -->
<div class="layout" id="appLayout">
  <!-- Sidebar -->
  <nav class="sidebar hidden" id="sidebar">
    <div class="sidebar-section-label">Visualizações</div>
  </nav>

  <!-- Main -->
  <main class="main" id="mainArea">

    <!-- Auth screen -->
    <div class="auth-screen" id="authScreen">
      <div class="auth-card">
        <div class="auth-title" id="authTitle">Entrar</div>
        <div class="auth-sub" id="authSub">Acesse sua área para salvar e abrir dashboards por usuário.</div>
        <form class="auth-form" id="authForm">
          <div class="auth-field hidden" id="displayNameFieldWrap">
            <label for="displayNameInput">Nome</label>
            <input type="text" id="displayNameInput" autocomplete="name" maxlength="120"/>
          </div>
          <div class="auth-field">
            <label for="emailInput">E-mail</label>
            <input type="email" id="emailInput" autocomplete="email" required/>
          </div>
          <div class="auth-field">
            <label for="passwordInput">Senha</label>
            <input type="password" id="passwordInput" autocomplete="current-password" required/>
          </div>
          <button class="auth-submit" id="authSubmitBtn" type="submit">Entrar</button>
        </form>
        <div class="upload-error" id="authError"></div>
        <div class="auth-note hidden" id="authNote"></div>
      </div>
    </div>

    <!-- Upload screen -->
    <div class="upload-screen hidden" id="uploadScreen">
      <div class="home-panel">
      <div class="upload-card">
        <div class="upload-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/>
            <polyline points="14 2 14 8 20 8"/><line x1="12" y1="18" x2="12" y2="12"/>
            <line x1="9" y1="15" x2="15" y2="15"/>
          </svg>
        </div>
        <div class="upload-title">Abrir relatório Planner</div>
        <div class="upload-sub">Carregue a exportação bruta do Microsoft Planner para visualizar os dados interativamente.</div>
        <div class="drop-zone" id="dropZone">
          <input type="file" id="fileInput" accept=".xlsx"/>
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="color:var(--muted);margin:0 auto;display:block">
            <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M17 8l-5-5-5 5M12 3v12"/>
          </svg>
          <div class="dz-text">
            <strong>Arraste o arquivo ou clique para selecionar</strong>
            Exportação do Microsoft Planner
          </div>
          <span class="dz-ext">.xlsx</span>
        </div>
        <div class="upload-progress" id="uploadProgress">
          <div class="prog-bar-wrap"><div class="prog-bar" id="progBar"></div></div>
          <div class="prog-text" id="progText">Enviando…</div>
        </div>
        <div class="upload-error" id="uploadError"></div>
      </div>
      <div class="library-card">
        <div class="library-head">
          <div>
            <div class="library-title">Meus dashboards</div>
            <div class="library-sub" id="librarySubtitle">Carregando dashboards salvosâ€¦</div>
          </div>
          <button class="btn-small" id="btnRefreshReports" onclick="loadReports()">Atualizar</button>
        </div>
        <div class="upload-error" id="reportsError"></div>
        <div class="reports-grid" id="reportsList"></div>
        <div class="reports-empty hidden" id="reportsEmpty">Nenhum dashboard salvo ainda. Envie um .xlsx para criar o primeiro snapshot.</div>
      </div>
      </div>
    </div>

    <div class="admin-screen hidden" id="adminScreen">
      <div class="admin-layout">
        <section class="admin-card">
          <div class="admin-card-title" id="adminFormTitle">Novo usuario</div>
          <div class="admin-card-sub" id="adminFormSub">Crie acessos individuais para sua equipe e defina quem tambem pode administrar usuarios.</div>
          <form class="admin-form" id="adminUserForm">
            <div class="auth-field">
              <label for="adminDisplayNameInput">Nome</label>
              <input type="text" id="adminDisplayNameInput" maxlength="120" required />
            </div>
            <div class="auth-field">
              <label for="adminEmailInput">E-mail</label>
              <input type="email" id="adminEmailInput" maxlength="320" required />
            </div>
            <div class="auth-field">
              <label for="adminPasswordInput">Senha</label>
              <input type="password" id="adminPasswordInput" minlength="10" />
            </div>
            <div class="auth-field">
              <label for="adminRoleInput">Perfil</label>
              <select id="adminRoleInput">
                <option value="user">Usuario</option>
                <option value="admin">Admin</option>
                <option value="disabled">Desativado</option>
              </select>
            </div>
            <div class="admin-form-note" id="adminPasswordHint">A senha inicial deve ter ao menos 12 caracteres, com letras e numeros, sem padroes obvios.</div>
            <div class="upload-error" id="adminFormError"></div>
            <div class="admin-form-actions">
              <button class="auth-submit" id="adminSubmitBtn" type="submit">Criar usuario</button>
              <button class="btn-small hidden" id="adminCancelBtn" type="button" onclick="resetAdminForm()">Cancelar</button>
            </div>
          </form>
        </section>

        <section class="admin-card">
          <div class="library-head">
            <div>
              <div class="library-title">Usuarios</div>
              <div class="library-sub" id="adminUsersSubtitle">Carregando usuarios...</div>
            </div>
            <button class="btn-small" type="button" onclick="loadAdminUsers()">Atualizar</button>
          </div>
          <div class="upload-error" id="adminUsersError"></div>
          <div class="admin-users-table-wrap" id="adminUsersList"></div>
          <div class="reports-empty hidden" id="adminUsersEmpty">Nenhum usuario adicional cadastrado ainda.</div>
        </section>
      </div>
    </div>

    <div class="admin-screen hidden" id="customChartScreen">
      <div class="admin-layout">
        <section class="admin-card">
          <div class="admin-card-title" id="customChartFormTitle">Novo grafico customizado</div>
          <div class="admin-card-sub" id="customChartFormSub">Monte uma visualizacao a partir dos datasets ja calculados pelo dashboard, sem mexer nos graficos nativos.</div>
          <form class="admin-form" id="customChartForm">
            <div class="auth-field">
              <label for="customChartNameInput">Nome do grafico</label>
              <input type="text" id="customChartNameInput" maxlength="160" required />
            </div>
            <div class="auth-field">
              <label for="customChartGroupInput">Categoria no menu</label>
              <select id="customChartGroupInput">
                <option value="Resumo">Resumo</option>
                <option value="Andamento">Andamento</option>
                <option value="Distribuição">Distribuição</option>
                <option value="Tempo">Tempo</option>
              </select>
            </div>
            <div class="auth-field">
              <label for="customChartSubtitleInput">Subtitulo</label>
              <input type="text" id="customChartSubtitleInput" maxlength="255" />
            </div>
            <div class="auth-field">
              <label for="customChartSourceInput">Fonte de dados</label>
              <select id="customChartSourceInput"></select>
            </div>
            <div class="auth-field">
              <label for="customChartMetricInput">Metrica</label>
              <select id="customChartMetricInput"></select>
            </div>
            <div class="auth-field">
              <label for="customChartTypeOptions">Tipos disponiveis</label>
              <div class="admin-check-grid" id="customChartTypeOptions"></div>
            </div>
            <div class="auth-field">
              <label for="customChartDefaultTypeInput">Tipo inicial</label>
              <select id="customChartDefaultTypeInput"></select>
            </div>
            <div class="auth-field">
              <label for="customChartSortInput">Ordenacao</label>
              <select id="customChartSortInput">
                <option value="metric_desc">Maior valor primeiro</option>
                <option value="metric_asc">Menor valor primeiro</option>
                <option value="label_asc">Nome A-Z</option>
                <option value="label_desc">Nome Z-A</option>
              </select>
            </div>
            <div class="auth-field">
              <label for="customChartLimitInput">Limite de itens</label>
              <input type="number" id="customChartLimitInput" min="1" max="50" placeholder="Opcional" />
            </div>
            <div class="auth-field">
              <label for="customChartOrderInput">Ordem de exibicao</label>
              <input type="number" id="customChartOrderInput" min="0" max="9999" value="0" />
            </div>
            <div class="auth-field">
              <label for="customChartEnabledInput">Status</label>
              <select id="customChartEnabledInput">
                <option value="1">Ativo</option>
                <option value="0">Inativo</option>
              </select>
            </div>
            <div class="admin-form-note" id="customChartFormHint">V1 segura: apenas datasets e metricas homologadas. Sem regra livre, SQL ou codigo.</div>
            <div class="upload-error" id="customChartFormError"></div>
            <div class="admin-form-actions">
              <button class="auth-submit" id="customChartSubmitBtn" type="submit">Criar grafico</button>
              <button class="btn-small hidden" id="customChartCancelBtn" type="button" onclick="resetCustomChartForm()">Cancelar</button>
            </div>
          </form>
        </section>

        <section class="admin-card">
          <div class="library-head">
            <div>
              <div class="library-title">Graficos customizados</div>
              <div class="library-sub" id="customChartsSubtitle">Carregando graficos...</div>
            </div>
            <button class="btn-small" type="button" onclick="loadAdminCustomCharts()">Atualizar</button>
          </div>
          <div class="upload-error" id="customChartsError"></div>
          <div class="admin-users-table-wrap" id="customChartsList"></div>
          <div class="reports-empty hidden" id="customChartsEmpty">Nenhum grafico customizado cadastrado ainda.</div>
        </section>
      </div>

      <div class="profile-rules-wrap">
        <section class="admin-card">
          <div class="admin-card-title" id="profileRuleFormTitle">Novo perfil customizado</div>
          <div class="admin-card-sub" id="profileRuleFormSub">Use o perfil extraido pelo sistema como base e sobreponha com regras adicionais quando precisar agrupar ou corrigir casos.</div>
          <form class="admin-form" id="profileRuleForm">
            <div class="auth-field">
              <label for="profileRuleNameInput">Nome do perfil</label>
              <input type="text" id="profileRuleNameInput" maxlength="80" required />
            </div>
            <div class="auth-field">
              <label for="profileRuleBaseProfilesInput">Perfis base extraidos</label>
              <input type="text" id="profileRuleBaseProfilesInput" maxlength="500" placeholder="Ex.: Devs; UX; Requisitos" />
            </div>
            <div class="auth-field">
              <label for="profileRuleLabelsInput">Termos de rotulo</label>
              <input type="text" id="profileRuleLabelsInput" maxlength="500" placeholder="Ex.: .dev; backend; frontend" />
            </div>
            <div class="auth-field">
              <label for="profileRuleAssigneeInput">Termos de responsavel</label>
              <input type="text" id="profileRuleAssigneeInput" maxlength="500" placeholder="Ex.: designer; qa; joao" />
            </div>
            <div class="auth-field">
              <label for="profileRuleBucketInput">Termos de bucket</label>
              <input type="text" id="profileRuleBucketInput" maxlength="500" placeholder="Ex.: gestao; em teste" />
            </div>
            <div class="auth-field">
              <label for="profileRulePriorityInput">Prioridade</label>
              <input type="number" id="profileRulePriorityInput" min="0" max="9999" value="100" />
            </div>
            <div class="auth-field">
              <label for="profileRuleEnabledInput">Status</label>
              <select id="profileRuleEnabledInput">
                <option value="1">Ativo</option>
                <option value="0">Inativo</option>
              </select>
            </div>
            <div class="admin-form-note" id="profileRuleHint">A regra entra antes do perfil base extraido. Quanto menor a prioridade, mais cedo a regra e aplicada.</div>
            <div class="upload-error" id="profileRulesFormError"></div>
            <div class="admin-form-actions">
              <button class="auth-submit" id="profileRuleSubmitBtn" type="submit">Criar perfil</button>
              <button class="btn-small hidden" id="profileRuleCancelBtn" type="button" onclick="resetProfileRuleForm()">Cancelar</button>
            </div>
          </form>
        </section>

        <section class="admin-card">
          <div class="library-head">
            <div>
              <div class="library-title">Perfis customizados</div>
              <div class="library-sub" id="profileRulesSubtitle">Carregando perfis...</div>
            </div>
            <button class="btn-small" type="button" onclick="loadAdminProfileRules()">Atualizar</button>
          </div>
          <div class="upload-error" id="profileRulesError"></div>
          <div class="admin-users-table-wrap" id="profileRulesList"></div>
          <div class="reports-empty hidden" id="profileRulesEmpty">Nenhum perfil customizado cadastrado ainda.</div>
        </section>
      </div>
    </div>

    <!-- Dashboard -->
    <div class="dashboard" id="dashboard">
      <div class="chart-header" id="chartHeader">
        <div class="chart-title-row">
          <div>
            <div class="chart-title" id="chartTitle">—</div>
            <div class="chart-subtitle" id="chartSubtitle"></div>
          </div>
        </div>
        <div class="chart-toolbar">
          <div class="chart-filters" id="chartFilters"></div>
          <div class="chart-actions">
            <button class="btn-small" id="btnGenerateSummary" type="button" onclick="generateDashboardSummary()">Resumo IA</button>
            <div class="type-selector" id="typeSelector"></div>
          </div>
        </div>
      </div>
      <div class="warn-banner" id="warnBanner">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="flex-shrink:0;margin-top:1px">
          <path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/>
          <line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/>
        </svg>
        <span id="warnText"></span>
      </div>
      <div class="summary-card" id="summaryCard">
        <div class="summary-head">
          <div>
            <div class="summary-title" id="summaryTitle">Resumo do dashboard</div>
            <div class="summary-meta" id="summaryMeta">Gere um resumo executivo a partir dos dados estruturados do dashboard.</div>
          </div>
          <div class="summary-actions">
            <button class="btn-small hidden" id="btnCopySummary" type="button" onclick="copyDashboardSummary()">Copiar</button>
            <button class="btn-small hidden" id="btnHideSummary" type="button" onclick="hideDashboardSummary()">Ocultar</button>
          </div>
        </div>
        <div class="summary-body">
          <div class="summary-status hidden" id="summaryStatus">Gerando resumo...</div>
          <div class="upload-error summary-error" id="summaryError"></div>
          <div class="summary-content" id="summaryContent"></div>
        </div>
      </div>
      <div class="chart-body" id="chartBody">
        <div class="chart-plot-wrap" id="chartPlotWrap">
          <div id="mainPlot" style="width:100%;height:100%;min-height:420px"></div>
        </div>
      </div>
    </div>

  </main>
</div>


<!-- Scripts — ordem de carregamento importa -->
<script src="/static/js/config.js"></script>   <!-- 1. constantes globais -->
<script src="/static/js/utils.js"></script>    <!-- 2. estado global + helpers + apiRequest -->
<script src="/static/js/ui.js"></script>       <!-- 3. tema e paleta -->
<script src="/static/js/refs.js"></script>     <!-- 4. referências DOM (antes dos listeners) -->
<script src="/static/js/auth.js"></script>     <!-- 5. sessão e autenticação -->
<script src="/static/js/reports.js"></script>  <!-- 6. biblioteca de relatórios -->
<script src="/static/js/admin.js"></script>    <!-- 7. painel admin -->
<script src="/static/js/upload.js"></script>   <!-- 8. upload de arquivo -->
<script src="/static/js/charts.js"></script>   <!-- 9. renderização de gráficos -->
<script src="/static/js/dashboard.js"></script><!-- 10. dashboard principal -->
<script src="/static/js/app.js"></script>      <!-- 11. init e resize -->

</body>
</html>
